SECRET_KEY=dev-only-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Assistente por IA (Google Gemini)
# =============================================================================
# Deixe AI_API_KEY vazia para desligar completamente a IA (fallback offline).
# Provedor suportado hoje: gemini. Para trocar de modelo, veja:
#   https://ai.google.dev/gemini-api/docs/models
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=4096
